ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
API_DESCRIPTION="User-Defined Zone Message Distribution Platform"
API_TITLE="Zone Weaver API"
API_VERSION=1.0.0
DATABASE_URL="Table External URL"
H3_DEFAULT_RESOLUTION=13
H3_MAX_RESOLUTION=15
H3_MIN_RESOLUTION=0
MAX_ZONES_ADMINISTRATOR=3
MAX_ZONES_ADMINISTRATOR_PRIMARY=2
MAX_ZONES_USER=1
SECRET_KEY=your-change-me-secret-key-minimum-32-characters-long-for-production
DB_PORT=25060
# Optional. Catbox account userhash from https://catbox.moe → account settings.
# Datacenter hosts usually cannot use anonymous Catbox (412 Invalid uploader).
# Without a working Catbox upload, avatars are stored compressed on the owner row.
CATBOX_USERHASH=
# HTTPS origin for guest/member QR links (no trailing slash).
GUEST_ACCESS_APP_BASE_URL=https://safe-zone-patrol-server.onrender.com
# Android App Links: comma-separated SHA-256 cert fingerprints (Play App Signing + upload key).
# ANDROID_SHA256_CERT_FINGERPRINTS=AB:CD:...
# iOS Universal Links: Apple Developer Team ID.
# APPLE_TEAM_ID=
